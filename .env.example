# Activation gate
# 激活码列表，多个用逗号分隔
ACTIVATION_KEYS=demo-key-1,demo-key-2,demo-key-3,demo-key-4,demo-admin-key

# 激活码权限映射配置（推荐使用 JSON 格式）
# 权限组合示例：
#   "sabrina"                  -> 只有多模型PK
#   "open-day"                 -> 只有开放日选址
#   "sabrina,open-day"         -> 有多模型PK和开放日选址
#   "sabrina,open-day,selling-houses,market-management,rational-owner" -> 除了admin的所有权限
#   "admin"                    -> 只有管理后台（不推荐，管理员通常也需要访问其他功能）
#   "admin,sabrina,open-day,selling-houses,market-management,rational-owner" -> 所有权限
ACTIVATION_KEY_PERMISSIONS={
  "demo-key-1":"sabrina",
  "demo-key-2":"open-day",
  "demo-key-3":"sabrina,open-day",
  "demo-key-4":"sabrina,open-day,selling-houses,market-management,rational-owner",
  "demo-admin-key":"admin,sabrina,open-day,selling-houses,market-management,rational-owner"
}

# 默认用户，JSON 格式或每行一个，格式：email=allowedWorkspaces
# 示例：[{"email":"admin@ke.com","allowedWorkspaces":"admin,sabrina,open-day,selling-houses,market-management,rational-owner","displayName":"管理员"}]
AUTH_DEFAULT_USERS=

# 本地开发白名单邮箱，这些邮箱可免验证码登录
# 多个邮箱用逗号分隔
AUTH_LOCAL_WHITELIST=

# 跳过验证码的邮箱列表（用于测试和演示）
AUTH_VERIFICATION_BYPASS_EMAILS=

# Session 签名密钥，生产环境务必修改
AUTH_SESSION_SECRET=change-this-to-a-secure-random-string

# Email configuration
EMAIL_FROM=noreply@ke.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Server configuration
PORT=3000
VITE_HMR_PORT=24700

# Open Day storage configuration
OPEN_DAY_STORAGE_BACKEND=local
OPEN_DAY_CACHE_BACKEND=memory
OPEN_DAY_UPLOAD_BACKEND=local

# Open Day cloud storage (auto-provisioned by Vercel Marketplace / Neon)
DATABASE_URL=
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGPASSWORD=
PGDATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
BLOB_READ_WRITE_TOKEN=

# Volcengine Ark
ARK_API_KEY=
ARK_REQUEST_TIMEOUT_MS=360000
ARK_REQUEST_MAX_RETRIES=1
ARK_REQUEST_RETRY_DELAY_MS=600

# IKunCode
IKUN_API_KEY=

# Tencent Hunyuan
HUNYUAN_API_KEY=
HUNYUAN_REQUEST_TIMEOUT_MS=360000

# Alibaba DashScope / Bailian
DASHSCOPE_API_KEY=
DASHSCOPE_REQUEST_TIMEOUT_MS=360000
