{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/activate",
      "destination": "/api/auth?mode=activate"
    },
    {
      "source": "/api/models",
      "destination": "/api/compare"
    },
    {
      "source": "/api/maintainer-leaderboard",
      "destination": "/api/maintainer-runs?view=leaderboard"
    },
    {
      "source": "/api/compare-stream",
      "destination": "/api/compare?stream=1"
    },
    {
      "source": "/api/open-day-score",
      "destination": "/api/open-day-analyses"
    },
    {
      "source": "/api/open-day-scenario-versions",
      "destination": "/api/open-day-scenarios?view=versions"
    },
    {
      "source": "/0609",
      "destination": "/0609/index.html"
    },
    {
      "source": "/0609/",
      "destination": "/0609/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 300
    }
  }
}
