{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/activate",
      "destination": "/api/auth?mode=activate"
    },
    {
      "source": "/api/models",
      "destination": "/api/compare"
    },
    {
      "source": "/api/maintainer-leaderboard",
      "destination": "/api/maintainer-runs?view=leaderboard"
    },
    {
      "source": "/api/compare-stream",
      "destination": "/api/compare?stream=1"
    },
    {
      "source": "/api/open-day-score",
      "destination": "/api/open-day-analyses"
    },
    {
      "source": "/api/open-day-scenario-versions",
      "destination": "/api/open-day-scenarios?view=versions"
    },
    {
      "source": "/api/selling-houses-wechat-replies",
      "destination": "/api/selling-houses-ai?route=selling-houses-wechat-replies"
    },
    {
      "source": "/api/selling-houses-wechat-turns",
      "destination": "/api/selling-houses-ai?route=selling-houses-wechat-turns"
    },
    {
      "source": "/api/selling-houses-action-advice",
      "destination": "/api/selling-houses-ai?route=selling-houses-action-advice"
    },
    {
      "source": "/api/selling-houses-action-feedback",
      "destination": "/api/selling-houses-ai?route=selling-houses-action-feedback"
    },
    {
      "source": "/api/ai-arrangement",
      "destination": "/api/selling-houses-ai?route=ai-arrangement"
    },
    {
      "source": "/api/daily-story",
      "destination": "/api/selling-houses-ai?route=daily-story"
    },
    {
      "source": "/api/scenario-opening-story",
      "destination": "/api/selling-houses-ai?route=scenario-opening-story"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 300
    }
  }
}
